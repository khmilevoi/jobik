{
  "name": "@jobik/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "files": [
    "bin",
    "dist"
  ],
  "bin": {
    "jobik-studio": "./bin/jobik-studio.mjs"
  },
  "scripts": {
    "build": "tsdown && vite build",
    "build:studio": "vite build",
    "dev:studio": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ../../vitest.config.ts packages/ui/"
  },
  "dependencies": {
    "@jobik/core": "workspace:*",
    "@reatom/core": "^1001.3.0",
    "@reatom/react": "^1001.0.1",
    "@xyflow/react": "12.11.5",
    "errore": "0.14.1",
    "vite": "8.2.2"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server/index.ts",
    "./package.json": "./package.json",
    "./style.css": "./dist/style.css"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./server": "./dist/server.mjs",
      "./package.json": "./package.json",
      "./style.css": "./dist/style.css"
    }
  }
}
